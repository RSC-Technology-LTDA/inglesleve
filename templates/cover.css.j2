{% set n = slide.items|length %}
.hero { margin: auto 0; }
.brush { position: absolute; pointer-events: none; overflow: visible; }
.brush path { fill: none; stroke: var(--hot); stroke-linecap: round; vector-effect: non-scaling-stroke; }

/* statement: "PARE DE DIZER ~~BUT~~" */
.st { text-align: center; display: flex; flex-direction: column; align-items: center; }
.st-title { font-size: {{ 176 if slide.title|length < 14 else (140 if slide.title|length < 24 else 112) }}px; }
.st-strike { position: relative; font-size: {{ 230 if slide.strike|length <= 6 else (180 if slide.strike|length <= 10 else 132) }}px; margin-top: 4px; padding: 0 24px; }
.st-strike .brush { left: -2%; top: 6%; width: 104%; height: 80%; }
.st-strike .brush path { stroke-width: 12px; }
.st-sub { position: relative; font-size: 54px; font-weight: 700; margin-top: 34px; line-height: 1.2; max-width: 860px; }
.st-sub .brush { left: 4%; right: 4%; bottom: -30px; width: 92%; height: 26px; }
.st-sub .brush path { stroke-width: 10px; }
.st-emo { --s: 230px; margin-top: 64px; }

/* equation: "hungry + angry = hangry" */
.eq { display: flex; flex-direction: column; align-items: center; text-align: center; }
.eq-title { font-size: 84px; margin-bottom: 34px; }
.eq-row { display: flex; align-items: center; justify-content: center; gap: 18px; }
.eq-in { --s: {{ 260 if n <= 3 else 190 }}px; display: flex; flex-direction: column; align-items: center; width: {{ 360 if n <= 3 else 260 }}px; }
.eq .en { font-size: 70px; margin-top: 12px; }
.eq .pt { font-size: 32px; font-weight: 600; margin-top: 4px; }
.op { width: 96px; height: 96px; flex: none; border-radius: 50%; background: var(--hot); color: #fff; display: grid; place-items: center; font-family: "Inter", sans-serif; font-weight: 800; font-size: 72px; line-height: 1; padding-bottom: 6px; }
.eq-eq { margin: 30px 0; }
.eq-res { --s: 250px; display: flex; align-items: center; gap: 34px; text-align: left; background: var(--card); border-radius: 44px; padding: 34px 64px 34px 40px; box-shadow: 0 18px 40px rgb(27 27 58 / .08); }
.eq-res .en { font-size: 112px; margin-top: 0; }
.eq-res .pt { font-size: 40px; }

/* versus: "Night × Knight" */
.vc { display: flex; flex-direction: column; align-items: center; text-align: center; }
.vc-title { font-size: {{ 104 if slide.title|length < 24 else 84 }}px; }
.vc-row { display: grid; grid-template-columns: 1fr 110px 1fr; align-items: center; width: 100%; margin-top: 56px; }
.vc-side { --s: 290px; display: flex; flex-direction: column; align-items: center; }
.vc-side .en { font-size: {{ 92 if (slide.items[:2]|map(attribute='en')|map('length')|list + [0])|max <= 9 else 70 }}px; margin-top: 18px; }
.vc-side .pron { font-size: 34px; margin-top: 8px; }
.vc-side .pt { font-size: 38px; font-weight: 600; margin-top: 6px; }
.vc-x { width: 104px; height: 104px; border-radius: 50%; background: var(--hot); color: #fff; display: grid; place-items: center; font-family: "Anton", sans-serif; font-size: 48px; justify-self: center; }
.vc-sub { font-size: 42px; font-weight: 600; margin-top: 64px; color: var(--muted); }

/* grid: vocabulário com ilustrações */
.gr-title { font-size: {{ 104 if slide.title|length < 22 else 84 }}px; text-align: center; }
.gr-grid { display: grid; grid-template-columns: repeat({{ 2 if n <= 4 else 3 }}, 1fr); gap: 24px; margin-top: 52px; }
.gr-cell { --s: {{ 200 if n <= 4 else 150 }}px; background: var(--card); border-radius: 32px; padding: 30px 14px 28px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.gr-cell .en { font-size: {{ 60 if n <= 4 else 46 }}px; margin-top: 14px; }
.gr-cell .pt { font-size: {{ 32 if n <= 4 else 27 }}px; font-weight: 600; margin-top: 4px; line-height: 1.2; }

/* hero: ilustração grande + título */
.hr { display: flex; flex-direction: column; align-items: center; text-align: center; }
.hr-emo { --s: 400px; }
.hr-title { font-size: {{ 150 if slide.title|length < 18 else (124 if slide.title|length < 30 else 104) }}px; margin-top: 44px; }
.hr-sub { font-size: 46px; font-weight: 600; margin-top: 26px; color: var(--muted); }
