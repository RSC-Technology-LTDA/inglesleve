<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<style>
{{ base_css }}
.content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 24px 0; }
.title { font-size: 92px; }
.subtitle { font-size: 42px; color: var(--muted); margin-top: 18px; line-height: 1.3; font-weight: 500; }

/* cover */
.cover .frame { background: var(--ink); color: var(--paper); }
.cover .top, .cover .foot { color: color-mix(in srgb, var(--paper) 70%, transparent); }
.cover .badge { background: var(--accent); color: var(--ink); }
.cover .hero { margin: auto 0; }
.cover .hero h1 { font-size: {{ 128 if slide.title|length < 40 else 104 }}px; }
.cover .hero h1 em { font-style: normal; color: var(--accent); }
.cover .hero p { font-size: 40px; margin-top: 36px; line-height: 1.3; opacity: .85; }
.swipe { font-size: 30px; font-weight: 700; color: var(--accent); }

/* term grid */
.grid { margin-top: 40px; display: grid; gap: 26px; grid-template-columns: repeat({{ 1 if slide.items|length == 1 else 2 }}, 1fr); }
.cell { background: var(--card); border-radius: 28px; padding: {{ '64px' if slide.items|length == 1 else ('30px 34px' if slide.items|length <= 4 else '22px 30px') }}; display: flex; flex-direction: column; gap: 6px; }
.cell .emo { font-size: {{ 140 if slide.items|length == 1 else (80 if slide.items|length <= 4 else 56) }}px; line-height: 1.1; }
.cell .en { font-size: {{ 96 if slide.items|length == 1 else (62 if slide.items|length <= 4 else 50) }}px; }
.cell .pt { font-size: {{ 44 if slide.items|length == 1 else (34 if slide.items|length <= 4 else 30) }}px; font-weight: 500; }
.cell .pron { font-size: {{ 40 if slide.items|length == 1 else (30 if slide.items|length <= 4 else 27) }}px; }
.cell .ex { font-size: 32px; margin-top: 24px; line-height: 1.35; }
.cell .ex .pt { display: block; font-style: normal; font-size: 28px; margin-top: 6px; }

/* reading */
.reading-box { margin-top: 48px; background: var(--card); border-radius: 28px; padding: 48px 52px; font-size: {{ 48 if slide.body|length < 350 else (42 if slide.body|length < 500 else (36 if slide.body|length < 700 else 31)) }}px; line-height: 1.5; font-weight: 500; white-space: pre-line; }

/* list */
.list { margin-top: 48px; display: flex; flex-direction: column; gap: 22px; }
.row { display: grid; grid-template-columns: 72px 1fr; gap: 22px; align-items: start; background: var(--card); border-radius: 26px; padding: 30px 32px; }
.num { width: 64px; height: 64px; border-radius: 50%; background: var(--accent); color: var(--ink); display: grid; place-items: center; font-weight: 800; font-size: 28px; }
.row .en { font-size: {{ 46 if slide.items|length <= 4 else 40 }}px; font-weight: 700; line-height: 1.2; }
.row .pt { font-size: 34px; margin-top: 6px; }
.row .pron { font-size: 30px; margin-top: 4px; display: block; }

/* compare */
.vs { margin-top: 56px; display: grid; grid-template-columns: 1fr 90px 1fr; align-items: center; }
.vs .side { background: var(--card); border-radius: 28px; padding: 40px 30px; text-align: center; min-height: 700px; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
.vs .emo { font-size: 150px; }
.vs .en { font-size: 80px; }
.vs .pt { font-size: 40px; font-weight: 500; }
.vs .pron { font-size: 34px; }
.vs .ex { font-size: 32px; margin-top: 14px; line-height: 1.3; }
.vs .x { text-align: center; font-size: 64px; color: var(--accent); font-weight: 800; }

/* quiz */
.opts { margin-top: 52px; display: flex; flex-direction: column; gap: 22px; }
.opt { display: flex; gap: 24px; align-items: center; border: 4px solid var(--ink); border-radius: 24px; padding: 40px 40px; font-size: 56px; font-weight: 600; }
.opt b { width: 80px; height: 80px; border-radius: 16px; background: var(--ink); color: var(--paper); display: grid; place-items: center; flex: none; }

/* cta */
.cta .frame { background: var(--accent); }
.cta .hero { margin: auto 0; }
.cta .hero h1 { font-size: 104px; }
.cta .hero p { font-size: 42px; margin-top: 36px; line-height: 1.35; font-weight: 500; white-space: pre-line; }
.cta .answers { margin-top: 36px; background: var(--paper); border-radius: 24px; padding: 26px 32px; font-size: 32px; line-height: 1.45; font-weight: 600; }
.cta .handle { font-size: 48px; font-weight: 800; margin-top: 56px; }
.cta .top, .cta .foot { color: var(--ink); }
.cta .dot { background: var(--ink); }
</style>
</head>
<body class="{{ slide.kind }}">
<div class="frame">
  <div class="top">
    <span class="flag"><span class="dot"></span>{{ brand.name }}</span>
    {% if slide.kind == 'cover' %}<span class="badge">Nível {{ pack.level }}</span>{% else %}<span class="page">{{ index }}/{{ total }}</span>{% endif %}
  </div>

  {% if slide.kind == 'cover' %}
    <div class="hero">
      <h1 class="display">{{ slide.title }}</h1>
      {% if slide.subtitle %}<p>{{ slide.subtitle }}</p>{% endif %}
    </div>
    <div class="foot"><span>@{{ brand.handle }}</span><span class="swipe">arrasta →</span></div>

  {% elif slide.kind == 'cta' %}
    <div class="hero">
      <h1 class="display">{{ slide.title }}</h1>
      {% if slide.body %}<p>{{ slide.body }}</p>{% endif %}
      {% if answers %}<div class="answers">{% for a in answers %}<div>✅ {{ a }}</div>{% endfor %}</div>{% endif %}
      <div class="handle">@{{ brand.handle }}</div>
    </div>
    <div class="foot"><span>salva 🔖 · compartilha ✈️</span><span></span></div>

  {% else %}
    <div class="content">
    <h2 class="display title">{{ slide.title }}</h2>
    {% if slide.subtitle %}<p class="subtitle">{{ slide.subtitle }}</p>{% endif %}

    {% if slide.kind == 'term' %}
      <div class="grid">
        {% for it in slide.items %}
        <div class="cell">
          {% if it.emoji %}<div class="emo">{{ it.emoji }}</div>{% endif %}
          <div class="en display">{{ it.en }}</div>
          {% if it.pronunciation %}<div class="pron">🗣 {{ it.pronunciation }}</div>{% endif %}
          <div class="pt">{{ it.pt }}</div>
          {% if slide.items|length == 1 and it.example_en %}
          <div class="ex">“{{ it.example_en }}”<span class="pt">{{ it.example_pt }}</span></div>
          {% endif %}
        </div>
        {% endfor %}
      </div>

    {% elif slide.kind == 'reading' %}
      <div class="reading-box">{{ slide.body }}</div>

    {% elif slide.kind == 'list' %}
      <div class="list">
        {% for it in slide.items %}
        <div class="row">
          <span class="num">{{ loop.index }}</span>
          <div>
            <div class="en">{{ it.en }}</div>
            <div class="pt">{{ it.pt }}</div>
            {% if it.pronunciation %}<span class="pron">🗣 {{ it.pronunciation }}</span>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>

    {% elif slide.kind == 'compare' %}
      <div class="vs">
        {% for it in slide.items[:2] %}
        <div class="side">
          {% if it.emoji %}<div class="emo">{{ it.emoji }}</div>{% endif %}
          <div class="en display">{{ it.en }}</div>
          {% if it.pronunciation %}<div class="pron">🗣 {{ it.pronunciation }}</div>{% endif %}
          <div class="pt">{{ it.pt }}</div>
          {% if it.example_en %}<div class="ex">“{{ it.example_en }}”</div>{% endif %}
        </div>
        {% if loop.first %}<div class="x">×</div>{% endif %}
        {% endfor %}
      </div>

    {% elif slide.kind == 'quiz' %}
      <div class="opts">
        {% for it in slide.items %}
        <div class="opt"><b>{{ "ABCDEF"[loop.index0] }}</b>{{ it.en }}</div>
        {% endfor %}
      </div>
    {% endif %}

    {% if slide.note and slide.kind != 'quiz' %}<div class="note">{{ slide.note }}</div>{% endif %}
    {% if slide.kind == 'quiz' %}<div class="note">Responde nos comentários 👇 a resposta tá no último slide</div>{% endif %}
    </div>
    <div class="foot"><span>@{{ brand.handle }}</span><span>{{ format_label }}</span></div>
  {% endif %}
</div>
</body>
</html>
